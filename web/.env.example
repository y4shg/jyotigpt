# --- JyotiGPT configuration ---
# Copy to .env for local development. In Docker, set these as environment
# variables on the container.

# Secret used to sign session cookies. If unset, a random secret is generated
# once and persisted to $DATA_DIR/.secret so sessions survive restarts.
# JYOTI_SECRET_KEY=

# Where runtime data lives (sqlite db, uploads, generated secret).
# DATA_DIR=./data

# Default admin account, created automatically on first boot if no users exist.
# JYOTI_ADMIN_EMAIL=admin@jyoti.local
# JYOTI_ADMIN_PASSWORD=admin

# --- Model providers ---

# Local Ollama instance.
# OLLAMA_BASE_URL=http://localhost:11434

# Any OpenAI-compatible endpoint.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Voice (optional OpenAI-compatible STT/TTS) ---
# AUDIO_STT_ENGINE=openai
# AUDIO_STT_OPENAI_API_KEY=
# AUDIO_TTS_ENGINE=openai
# AUDIO_TTS_OPENAI_API_KEY=

# --- Web search ---
# ENABLE_WEB_SEARCH=false
# SEARXNG_QUERY_URL=http://localhost:8888/search?q=
# SEARXNG_SECRET=
