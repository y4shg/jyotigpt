# JyotiGPT API server — Python 3.12 + FastAPI
FROM python:3.12-slim AS base

WORKDIR /app

# System deps for lxml, bcrypt, etc.
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libxml2-dev libxslt-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY api/pyproject.toml ./
RUN pip install --no-cache-dir ".[dev]" 2>/dev/null || pip install --no-cache-dir .

# Copy source
COPY api/ ./api/

WORKDIR /app/api

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/api/v1/config').raise_for_status()"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "jyoti_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
